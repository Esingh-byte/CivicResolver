# =============================================================
# CivicResolver — Root .gitignore
# =============================================================

# ── Environment secrets (NEVER commit) ──────────────────────
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.local

# ── Dependencies ─────────────────────────────────────────────
node_modules/
**/node_modules/
.vite-temp/
**/.vite-temp/

# ── Build output ─────────────────────────────────────────────
dist/
dist-ssr/
build/
client/dist/
client/build/

# ── Logs & Runtime ───────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
