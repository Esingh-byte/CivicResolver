# ─── CivicResolver Frontend — Environment Variable Template ────────
# Copy this file to .env and fill in your values.
# This file IS safe to commit — it contains no real secrets.
# ────────────────────────────────────────────────────────────────

# Backend API base URL (uses Vite dev proxy "/api" locally, or full URL in production)
#
# Local development (via Vite proxy):
#   VITE_API_URL=/api
#
# Local development (direct):
#   VITE_API_URL=http://localhost:5000/api

VITE_API_URL=/api

