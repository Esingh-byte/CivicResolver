# =============================================================
# CivicResolver Client — .gitignore
# =============================================================

# ── Environment secrets (NEVER commit) ──────────────────────
.env
.env.*
!.env.example
*.local

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.vite-temp/

# ── Build output ─────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
